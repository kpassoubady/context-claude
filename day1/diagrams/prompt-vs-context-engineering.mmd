%%{init: {"flowchart": {"wrappingWidth": 420}, "themeVariables": {"fontSize": "20px", "fontFamily": "Inter, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif", "primaryColor": "#e3f2fd", "primaryTextColor": "#1e293b", "primaryBorderColor": "#1a73e8", "lineColor": "#1a73e8", "secondaryColor": "#fff3e0", "tertiaryColor": "#e8f5e9", "background": "#ffffff", "edgeLabelBackground": "#ffffff", "clusterBkg": "#f5f7fa", "clusterBorder": "#e2e8f0", "titleColor": "#1a73e8"}}}%%
flowchart LR
    subgraph PROMPT["<b>Single-Turn Prompt Design</b>"]
        direction LR
        P_IN["<b>📝 Static Prompt</b><br/>wording & examples"] --> P_LLM["<b>🧠 Model Call</b><br/>single completion"] --> P_OUT["<b>📤 Response</b><br/>one-shot output"]
    end

    subgraph CONTEXT["<b>Agentic Context Engineering</b>"]
        direction LR
        C_ENV["<b>🗂️ Context Environment</b><br/>CLAUDE.md, rules, memory"] --> C_LOOP["<b>🔄 Agent Loop</b><br/>read, run, inspect"]
        C_TOOLS["<b>🔧 Tool Outputs</b><br/>files, grep, test logs"] --> C_LOOP
        C_LOOP --> C_VER["<b>✅ Verified Change</b><br/>tests & adherence"]
    end

    PROMPT -.-> CONTEXT

    style P_IN fill:#e3f2fd,stroke:#1a73e8
    style P_LLM fill:#fff3e0,stroke:#e65100
    style P_OUT fill:#e8f5e9,stroke:#2e7d32
    style C_ENV fill:#e3f2fd,stroke:#1a73e8
    style C_TOOLS fill:#f3e5f5,stroke:#7b1fa2
    style C_LOOP fill:#1a73e8,stroke:#0d47a1,color:#fff
    style C_VER fill:#e8f5e9,stroke:#2e7d32

