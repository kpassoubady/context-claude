%%{init: {"flowchart": {"wrappingWidth": 420}, "themeVariables": {"fontSize": "20px", "fontFamily": "Inter, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif", "primaryColor": "#e3f2fd", "primaryTextColor": "#1e293b", "primaryBorderColor": "#1a73e8", "lineColor": "#1a73e8", "secondaryColor": "#fff3e0", "tertiaryColor": "#e8f5e9", "background": "#ffffff", "edgeLabelBackground": "#ffffff", "clusterBkg": "#f5f7fa", "clusterBorder": "#e2e8f0", "titleColor": "#1a73e8"}}}%%
flowchart LR
    subgraph PARENT["<b>Parent Session Context</b>"]
        direction LR
        P_TASK["<b>🧭 Main Task</b><br/>orchestrates work"] --> P_RES["<b>📋 Verified Synthesis</b><br/>paths & findings only"]
    end

    subgraph SUBAGENT["<b>Isolated Subagent Context</b>"]
        direction LR
        S_WORK["<b>🕵️ Deep Exploration</b><br/>heavy Grep, Read, log scan"] --> S_SUM["<b>📤 Concise Report</b><br/>intermediate noise stays local"]
    end

    subgraph SOURCES["<b>Information Retrieval Choice</b>"]
        direction LR
        R_LOCAL["<b>💻 Local Repo Files</b><br/>direct Glob, Grep, Read"] --> R_EXT[("<b>🌐 External Corpus (RAG)</b><br/>ACL-filtered docs via MCP")]
    end

    PARENT -.-> SUBAGENT
    SUBAGENT -.-> SOURCES

    style P_TASK fill:#e3f2fd,stroke:#1a73e8
    style P_RES fill:#e8f5e9,stroke:#2e7d32
    style S_WORK fill:#1a73e8,stroke:#0d47a1,color:#fff
    style S_SUM fill:#f3e5f5,stroke:#7b1fa2
    style R_LOCAL fill:#fff3e0,stroke:#e65100
    style R_EXT fill:#fff3e0,stroke:#e65100

