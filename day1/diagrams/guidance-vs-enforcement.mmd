%%{init: {"flowchart": {"wrappingWidth": 420}, "themeVariables": {"fontSize": "20px", "fontFamily": "Inter, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif", "primaryColor": "#e3f2fd", "primaryTextColor": "#1e293b", "primaryBorderColor": "#1a73e8", "lineColor": "#1a73e8", "secondaryColor": "#fff3e0", "tertiaryColor": "#e8f5e9", "background": "#ffffff", "edgeLabelBackground": "#ffffff", "clusterBkg": "#f5f7fa", "clusterBorder": "#e2e8f0", "titleColor": "#1a73e8"}}}%%
flowchart LR
    subgraph GUIDANCE["<b>Model-Facing Guidance (Advisory)</b>"]
        direction LR
        G_FILES["<b>📘 CLAUDE.md & Rules</b><br/>conventions & commands"] --> G_MODEL["<b>🧠 Model Reasoning</b><br/>occupies context tokens"]
    end

    subgraph CONTROLS["<b>Execution Controls (Deterministic)</b>"]
        direction LR
        C_PRE["<b>🛡️ Permissions & PreToolUse</b><br/>allow, ask, or block before run"] --> C_EXEC["<b>⚙️ Tool Execution</b><br/>bounded runtime action"] --> C_POST["<b>🔍 PostToolUse Hook</b><br/>lint or check after action"]
    end

    GUIDANCE -.-> CONTROLS

    style G_FILES fill:#e3f2fd,stroke:#1a73e8
    style G_MODEL fill:#f3e5f5,stroke:#7b1fa2
    style C_PRE fill:#1a73e8,stroke:#0d47a1,color:#fff
    style C_EXEC fill:#fff3e0,stroke:#e65100
    style C_POST fill:#e8f5e9,stroke:#2e7d32

