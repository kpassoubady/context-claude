%%{init: {"flowchart": {"wrappingWidth": 420}, "themeVariables": {"fontSize": "20px", "fontFamily": "Inter, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif", "primaryColor": "#e3f2fd", "primaryTextColor": "#1e293b", "primaryBorderColor": "#1a73e8", "lineColor": "#1a73e8", "secondaryColor": "#fff3e0", "tertiaryColor": "#e8f5e9", "background": "#ffffff", "edgeLabelBackground": "#ffffff", "clusterBkg": "#f5f7fa", "clusterBorder": "#e2e8f0", "titleColor": "#1a73e8"}}}%%
flowchart LR
    GOAL["<b>🎯 Task Request</b><br/>bounded goal & scope"] --> GATHER["<b>🔍 Gather Context</b><br/>targeted Glob, Grep, Read"]
    GATHER --> ACT["<b>⚙️ Take Action</b><br/>edit code or run tool"]
    ACT --> VERIFY{"<b>🧪 Verify Result?</b>"}
    VERIFY -- "fail: bounded output" --> GATHER
    VERIFY -- "pass: tests & rules" --> DONE["<b>✅ Completed Task</b><br/>ready for review"]
    NOISE["<b>⚠️ Unfiltered Dump</b><br/>verbose logs & lockfiles"] -. "dilutes recall" .-> GATHER

    style GOAL fill:#e3f2fd,stroke:#1a73e8
    style GATHER fill:#f3e5f5,stroke:#7b1fa2
    style ACT fill:#1a73e8,stroke:#0d47a1,color:#fff
    style VERIFY fill:#fff3e0,stroke:#e65100
    style DONE fill:#e8f5e9,stroke:#2e7d32
    style NOISE fill:#fce4ec,stroke:#c62828

